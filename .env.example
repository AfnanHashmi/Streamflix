# Copy this file to .env and fill in real values before starting the server
# Generate a strong JWT_SECRET with: openssl rand -base64 48

JWT_SECRET=
NODE_ENV=production
PORT=4000
SITE_ORIGIN=https://biggboss24hrs.com
# Generate with: openssl rand -base64 32
# Used by OvenMediaEngine's REST API (Server.xml <Managers><API><AccessToken>)
# and by /root/ome-config/dvr_cleanup.sh to query it.
OME_API_ACCESS_TOKEN=

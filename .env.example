# Copy this file to .env and fill in real values before starting the server
# Generate a strong JWT_SECRET with: openssl rand -base64 48

JWT_SECRET=
NODE_ENV=production
PORT=4000
SITE_ORIGIN=https://biggboss24hrs.com
# Generate with: openssl rand -base64 32
# Used by OvenMediaEngine's REST API (Server.xml <Managers><API><AccessToken>)
# and by /root/ome-config/dvr_cleanup.sh and cf_purge_on_start.sh to query it,
# and by server.js's pollStreamLive() to detect when a stream ends.
OME_API_ACCESS_TOKEN=
# Generate with: openssl rand -base64 32
# Protects GET /admin/current-link (accessTokens.js) - the only route that
# uses it. Not IP-restricted; keep this secret.
ADMIN_KEY=
